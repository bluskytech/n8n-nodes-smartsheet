{
	"name": "Smartsheet: new row to Slack",
	"nodes": [
		{
			"parameters": {
				"sheetId": {
					"__rl": true,
					"mode": "list",
					"value": ""
				},
				"events": ["row.created"],
				"options": {}
			},
			"name": "Smartsheet Trigger",
			"type": "@bluskytech/n8n-nodes-smartsheet.smartsheetTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"resource": "message",
				"operation": "post",
				"select": "channel",
				"channelId": {
					"__rl": true,
					"mode": "name",
					"value": "#general"
				},
				"text": "=New row added to *{{ $json.sheetName }}* (row {{ $json.row.rowNumber }}): {{ $json.row.permalink }}",
				"otherOptions": {}
			},
			"name": "Slack",
			"type": "n8n-nodes-base.slack",
			"typeVersion": 2.2,
			"position": [300, 0]
		}
	],
	"connections": {
		"Smartsheet Trigger": {
			"main": [
				[
					{
						"node": "Slack",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
